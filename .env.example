DEEPSEEK_API_KEY=sk-xxx

# Agent 模式：v6（默认 NextAction）| v5（Tool Calling API）
# SLOWLOG_AGENT_MODE=v6
# 命令行可覆盖：go run ./cmd/slowlog-ai -agent-mode=v5
# 每轮决策打 stderr：SLOWLOG_AGENT_TRACE=1
# ask_question 时暂停等待终端输入：SLOWLOG_AGENT_HITL=1
# 详见 docs/agent/MODE.md · docs/agent/DEVELOP.md

# 本地 MySQL（MCP connect_mysql_instance 使用，勿提交真实密码到 Git）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=test

# ---------- RAG（完整说明见 docs/guides/RAG.md）----------
# SLOWLOG_RAG：tfidf（默认，make run/agent-run）| embedding | mock（agent-eval）
# SLOWLOG_RAG=tfidf
# SLOWLOG_RAG_TOPK=3
#
# embedding 时：SLOWLOG_EMBEDDING_PROVIDER=local（默认，不调 API）| http（需 Key）
# SLOWLOG_RAG=embedding
# SLOWLOG_EMBEDDING_PROVIDER=local
# SLOWLOG_EMBEDDING_PROVIDER=http
# SLOWLOG_EMBEDDING_API_KEY=
# SLOWLOG_EMBEDDING_BASE_URL=https://api.openai.com/v1
# SLOWLOG_EMBEDDING_MODEL=text-embedding-3-small
#
# 本地试跑：make rag-check | make rag-check-compare | make rag-check "你的查询"
# 合并前护栏：make check（test + agent-eval + rag-test + doc-links）
#
# HTTP API（G11）：make agent-api
# SLOWLOG_API_ADDR=:8080
# SLOWLOG_REPORT_DIR=reports
# SLOWLOG_ANALYZE_TIMEOUT=15m
# SLOWLOG_WEBHOOK_SECRET=change-me
# SLOWLOG_INGEST_MIN_QUERY_TIME=1.0
# SLOWLOG_API_PUBLIC_URL=http://127.0.0.1:8080
#
# RAG 磁盘索引（G13）
# SLOWLOG_RAG_PERSIST=1
# SLOWLOG_RAG_INDEX_DIR=data/rag-index
