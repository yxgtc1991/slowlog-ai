DEEPSEEK_API_KEY=sk-xxx

# 本地 MySQL（MCP connect_mysql_instance 使用，勿提交真实密码到 Git）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=test

# ---------- RAG（完整说明见 docs/RAG.md）----------
# SLOWLOG_RAG：tfidf（默认，make run/agent-run）| embedding | mock（agent-eval）
# SLOWLOG_RAG=tfidf
# SLOWLOG_RAG_TOPK=3
#
# embedding 时：SLOWLOG_EMBEDDING_PROVIDER=local（默认，不调 API）| http（需 Key）
# SLOWLOG_RAG=embedding
# SLOWLOG_EMBEDDING_PROVIDER=local
# SLOWLOG_EMBEDDING_PROVIDER=http
# SLOWLOG_EMBEDDING_API_KEY=
# SLOWLOG_EMBEDDING_BASE_URL=https://api.openai.com/v1
# SLOWLOG_EMBEDDING_MODEL=text-embedding-3-small
#
# 本地试跑：make rag-check | make rag-check-compare | make rag-check "你的查询"
